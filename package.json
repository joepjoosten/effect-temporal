{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "codegen": "pnpm --recursive --parallel run codegen",
    "build": "tsc -b tsconfig.build.json && pnpm --recursive --parallel run build",
    "check": "tsc -b tsconfig.json && node scripts/check-readme.mjs",
    "check-recursive": "pnpm --recursive exec tsc -b tsconfig.json",
    "dprint": "dprint fmt",
    "dprint-check": "dprint check",
    "lint": "eslint \"**/{src,test,examples,scripts,dtslint}/**/*.{ts,mjs}\"",
    "lint-fix": "pnpm lint --fix",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "changeset-version": "changeset version",
    "changeset-publish": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.0",
    "@babel/plugin-transform-export-namespace-from": "^8.1.0",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@effect/build-utils": "^0.8.9",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "latest",
    "@effect/vitest": "4.1.3",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@temporalio/testing": "^1.25.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "babel-plugin-annotate-pure-calls": "^0.5.0",
    "dprint": "^0.64.3",
    "effect": "4.1.3",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-codegen": "^0.34.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "glob": "^14.0.4",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  }
}
